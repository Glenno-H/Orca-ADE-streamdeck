{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Orca Deck",
	"Version": "0.5.0.0",
	"Author": "GKW",
	"Description": "See which of your Orca agents need you, at a glance, and jump straight to them. Unofficial; not made by Stably.",
	"URL": "https://github.com/Glenno-H/Orca-ADE-streamdeck",
	"UUID": "au.gkw.orcadeck",
	"Category": "Orca Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"PropertyInspectorPath": "ui/orca.html",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "disabled"
	},
	"Actions": [
		{
			"Name": "Agent",
			"UUID": "au.gkw.orcadeck.agent",
			"Icon": "imgs/actions/agent/icon",
			"Tooltip": "Shows an agent's status. Press to jump to it in Orca.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/agent/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Approve",
			"UUID": "au.gkw.orcadeck.approve",
			"Icon": "imgs/actions/approve/icon",
			"Tooltip": "Allows, once, the permission request of the agent you last jumped to.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/approve/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Deny",
			"UUID": "au.gkw.orcadeck.deny",
			"Icon": "imgs/actions/deny/icon",
			"Tooltip": "Denies the permission request of the agent you last jumped to.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/deny/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Next Waiting",
			"UUID": "au.gkw.orcadeck.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "Jumps to the next agent that's waiting on you.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/next/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Show Orca",
			"UUID": "au.gkw.orcadeck.show",
			"Icon": "imgs/actions/show/icon",
			"Tooltip": "Brings the Orca window to the front.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/show/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Usage",
			"UUID": "au.gkw.orcadeck.usage",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "How much of your Claude or Codex limit is used, and when it resets. Press to refresh.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"ShowTitle": false
				}
			]
		}
	]
}